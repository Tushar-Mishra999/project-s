# ─────────────────────────────────────────────────────────────
# Google Cloud / Vertex AI  (required)
# ─────────────────────────────────────────────────────────────
# Full JSON content of your GCP service account key file.
# The server writes this to a temp file so ADC picks it up.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Your GCP project ID (e.g. "my-gcp-project-123")
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region — us-central1 works for all models used here
GOOGLE_CLOUD_LOCATION=us-central1

# ─────────────────────────────────────────────────────────────
# Supabase  (required)
# ─────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────
# Neo4j Aura  (optional — Graph RAG feature)
# ─────────────────────────────────────────────────────────────
# Found in: console.neo4j.io → your instance → Connect
# URI must use neo4j+s:// scheme (not bolt:// or neo4j://)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-instance-password

# ─────────────────────────────────────────────────────────────
# Gmail OAuth  (optional — MoM email delivery feature)
# ─────────────────────────────────────────────────────────────
# Set up via Google Cloud Console → APIs → Gmail API → OAuth 2.0
GMAIL_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
GMAIL_REDIRECT_URI=https://your-app-url.com/oauth2callback
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# App  (optional)
# ─────────────────────────────────────────────────────────────
# Public URL of the deployed app — used for OAuth redirect URIs
APP_URL=https://your-app.onrender.com

# Server port (Render sets this automatically, don't set manually on Render)
PORT=3001
