{
  "name": "tech-sensing-feed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "build": "npx puppeteer browsers install chrome && npm --prefix client install && npm --prefix client run build",
    "production": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@google/genai": "^0.7.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^171.4.0",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^14.1.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.36.0",
    "pdf-parse": "^1.1.1",
    "rss-parser": "^3.13.0",
    "puppeteer": "^23.0.0",
    "voyageai": "^0.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
