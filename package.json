{
  "name": "tech-sensing-feed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "production": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@mendable/firecrawl-js": "^1.19.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.65.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
